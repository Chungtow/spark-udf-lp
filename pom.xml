<?xml version="1.0" encoding="UTF-8"?>
<!--
  spark-udf-lp：Spark 自定义 UDF（Hive 风格 GenericUDF）新项目
  编译/运行统一 Java 8（与集群 spark 容器 openjdk:8-jre-slim 一致）
  关键依赖均 provided：运行时由 spark 容器提供，避免类冲突
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.liangpu</groupId>
  <artifactId>spark-udf-lp</artifactId>
  <version>${revision}</version>
  <packaging>jar</packaging>

  <name>spark-udf-lp</name>
  <description>Spark 自定义 UDF（Hive 风格 GenericUDF），构建产物发布到集群 HDFS /udf 并注册 Hive 永久函数</description>

  <properties>
    <revision>1.0.0-SNAPSHOT</revision>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.source>1.8</maven.compiler.source>
    <maven.compiler.target>1.8</maven.compiler.target>
    <spark.version>3.3.1</spark.version>
    <hive.version>2.3.9</hive.version>
    <hadoop.version>3.1.4</hadoop.version>
    <junit.version>4.13.2</junit.version>
    <fastjson2.version>2.0.56</fastjson2.version>
  </properties>

  <dependencies>
    <!-- Spark SQL：编译期仅用到 UDF 相关类型；provided，运行时由 spark 容器提供 -->
    <dependency>
      <groupId>org.apache.spark</groupId>
      <artifactId>spark-sql_2.12</artifactId>
      <version>${spark.version}</version>
      <scope>provided</scope>
    </dependency>

    <!-- Spark Hive 集成：帮助信息注入（迭代 3）用到 HiveGenericUDF/HiveGenericUDTF/HiveUDAFFunction/
         HiveShim$HiveFunctionWrapper 包装类；provided，运行时由 spark 容器提供 -->
    <dependency>
      <groupId>org.apache.spark</groupId>
      <artifactId>spark-hive_2.12</artifactId>
      <version>${spark.version}</version>
      <scope>provided</scope>
      <exclusions>
        <!-- log4j 1.x 桥接（hive 2.3.9 传递）：把 log4j-api 依赖调解至 2.6.2，
             导致 org.apache.logging.log4j.util.ReflectionUtil（2.8.1+ 才有）缺失。
             排除后 classpath 取 spark-sql 的 log4j-api 2.17.2；运行时 spark 容器提供同款桥接 -->
        <exclusion>
          <groupId>org.apache.logging.log4j</groupId>
          <artifactId>log4j-1.2-api</artifactId>
        </exclusion>
        <exclusion>
          <groupId>org.apache.logging.log4j</groupId>
          <artifactId>log4j-slf4j-impl</artifactId>
        </exclusion>
        <exclusion>
          <groupId>log4j</groupId>
          <artifactId>log4j</artifactId>
        </exclusion>
      </exclusions>
    </dependency>

    <!-- Hive 兼容层：与 Spark 3.3.1 内置 Hive 版本一致（2.3.9），避免运行时类缺失 -->
    <dependency>
      <groupId>org.apache.hive</groupId>
      <artifactId>hive-exec</artifactId>
      <version>${hive.version}</version>
      <scope>provided</scope>
      <exclusions>
        <!-- pentaho-aggdesigner-algorithm 5.1.5-jhyde 为老 artifact，阿里云仓库缺失；
             UDF 编译/运行均用不到（hive-exec 的无关传递依赖），直接排除 -->
        <exclusion>
          <groupId>org.pentaho</groupId>
          <artifactId>*</artifactId>
        </exclusion>
        <!-- log4j 1.x 桥接（hive 2.3.9 传递链 hive-exec -> hive-llap-tez 引入 log4j-1.2-api 2.6.2）：
             把 log4j-api 依赖调解至 2.6.2，导致 org.apache.logging.log4j.util.ReflectionUtil（2.8.1+ 才有）
             缺失、单测报 NoClassDefFoundError。在 hive-exec 上排除可覆盖其整棵传递树 -->
        <exclusion>
          <groupId>org.apache.logging.log4j</groupId>
          <artifactId>log4j-1.2-api</artifactId>
        </exclusion>
        <exclusion>
          <groupId>org.apache.logging.log4j</groupId>
          <artifactId>log4j-slf4j-impl</artifactId>
        </exclusion>
        <exclusion>
          <groupId>log4j</groupId>
          <artifactId>log4j</artifactId>
        </exclusion>
      </exclusions>
    </dependency>

    <!-- Hadoop 客户端：与集群版本一致（software/hadoop-3.1.4.tar.gz） -->
    <dependency>
      <groupId>org.apache.hadoop</groupId>
      <artifactId>hadoop-client</artifactId>
      <version>${hadoop.version}</version>
      <scope>provided</scope>
    </dependency>

    <!-- JSON 解析引擎（json_* 函数系列）：阿里同源、JSONPath 语义贴近 MaxCompute；
         compile 作用域（非 provided），shade 重定位打入最终 jar，避免与集群其他组件类冲突 -->
    <dependency>
      <groupId>com.alibaba.fastjson2</groupId>
      <artifactId>fastjson2</artifactId>
      <version>${fastjson2.version}</version>
    </dependency>

    <!-- 地理引擎（st_* 函数系列，迭代 6）：JTS Topology Suite——WKT/WKB 解析 + 空间关系计算
         （contains/covers/intersects/within/distance）；compile 作用域，shade 打入最终 jar。
         球面距离（米制）由自实现 haversine 提供（见 udf/geo/GeoUtils）。 -->
    <dependency>
      <groupId>org.locationtech.jts</groupId>
      <artifactId>jts-core</artifactId>
      <version>1.19.0</version>
    </dependency>

    <!-- 单元测试 -->
    <dependency>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>spark-udf-lp-${revision}</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.11.0</version>
        <configuration>
          <source>1.8</source>
          <target>1.8</target>
          <encoding>UTF-8</encoding>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.1.2</version>
        <configuration>
          <!-- 单测失败即构建失败（本地闸门） -->
          <failIfNoTests>false</failIfNoTests>
        </configuration>
      </plugin>
      <!-- shade：将 fastjson2 重定位打入最终 jar（com.alibaba.fastjson2 -> com.liangpu.shaded.fastjson2） -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.5.1</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <relocations>
                <relocation>
                  <pattern>com.alibaba.fastjson2</pattern>
                  <shadedPattern>com.liangpu.shaded.fastjson2</shadedPattern>
                </relocation>
              </relocations>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>

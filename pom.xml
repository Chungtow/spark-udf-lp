<?xml version="1.0" encoding="UTF-8"?>
<!--
  spark-udf-lp：Spark 自定义 UDF（Hive 风格 GenericUDF）新项目
  编译/运行统一 Java 8（与集群 spark 容器 openjdk:8-jre-slim 一致）
  关键依赖均 provided：运行时由 spark 容器提供，避免类冲突
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.liangpu</groupId>
  <artifactId>spark-udf-lp</artifactId>
  <version>${revision}</version>
  <packaging>jar</packaging>

  <name>spark-udf-lp</name>
  <description>Spark 自定义 UDF（Hive 风格 GenericUDF），构建产物发布到集群 HDFS /udf 并注册 Hive 永久函数</description>

  <properties>
    <revision>1.0.0-SNAPSHOT</revision>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.source>1.8</maven.compiler.source>
    <maven.compiler.target>1.8</maven.compiler.target>
    <spark.version>3.3.1</spark.version>
    <hive.version>2.3.9</hive.version>
    <hadoop.version>3.1.4</hadoop.version>
    <junit.version>4.13.2</junit.version>
  </properties>

  <dependencies>
    <!-- Spark SQL：编译期仅用到 UDF 相关类型；provided，运行时由 spark 容器提供 -->
    <dependency>
      <groupId>org.apache.spark</groupId>
      <artifactId>spark-sql_2.12</artifactId>
      <version>${spark.version}</version>
      <scope>provided</scope>
    </dependency>

    <!-- Hive 兼容层：与 Spark 3.3.1 内置 Hive 版本一致（2.3.9），避免运行时类缺失 -->
    <dependency>
      <groupId>org.apache.hive</groupId>
      <artifactId>hive-exec</artifactId>
      <version>${hive.version}</version>
      <scope>provided</scope>
      <exclusions>
        <!-- pentaho-aggdesigner-algorithm 5.1.5-jhyde 为老 artifact，阿里云仓库缺失；
             UDF 编译/运行均用不到（hive-exec 的无关传递依赖），直接排除 -->
        <exclusion>
          <groupId>org.pentaho</groupId>
          <artifactId>*</artifactId>
        </exclusion>
      </exclusions>
    </dependency>

    <!-- Hadoop 客户端：与集群版本一致（software/hadoop-3.1.4.tar.gz） -->
    <dependency>
      <groupId>org.apache.hadoop</groupId>
      <artifactId>hadoop-client</artifactId>
      <version>${hadoop.version}</version>
      <scope>provided</scope>
    </dependency>

    <!-- 单元测试 -->
    <dependency>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>spark-udf-lp-${revision}</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.11.0</version>
        <configuration>
          <source>1.8</source>
          <target>1.8</target>
          <encoding>UTF-8</encoding>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.1.2</version>
        <configuration>
          <!-- 单测失败即构建失败（本地闸门） -->
          <failIfNoTests>false</failIfNoTests>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
